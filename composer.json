{
    "name": "github/copilot-php-sdk",
    "description": "PHP SDK for programmatic control of GitHub Copilot CLI via JSON-RPC",
    "type": "library",
    "license": "MIT",
    "keywords": ["github", "copilot", "sdk", "ai", "llm"],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Github\\Copilot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Github\\Copilot\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
